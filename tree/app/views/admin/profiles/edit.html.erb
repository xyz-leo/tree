<% content_for :title, "Edit profile" %>

<section class="panel">
  <h1 class="panel-header label">Edit profile</h1>

  <%= form_with model: @profile, url: admin_profile_path, method: :patch, class: "form" do |form| %>
    <%= render "admin/errors", record: @profile %>

    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, required: true %>
    </div>

    <div class="field">
      <%= form.label :handle %>
      <%= form.text_field :handle, required: true %>
      <small>Shown in the header and the browser tab.</small>
    </div>

    <div class="field">
      <%= form.label :bio_pt, "Bio (PT)" %>
      <%= form.text_area :bio_pt, rows: 3 %>
    </div>

    <div class="field">
      <%= form.label :bio_en, "Bio (EN)" %>
      <%= form.text_area :bio_en, rows: 3 %>
      <small>Leave blank to use the Portuguese text.</small>
    </div>

    <div class="form-actions">
      <%= form.submit "Save", class: "btn" %>
      <%= link_to "Cancel", admin_root_path, class: "action" %>
    </div>
  <% end %>
</section>
