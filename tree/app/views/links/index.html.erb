<% content_for :title, @profile.handle %>
<% bio = @profile.bio(@lang) %>
<% content_for :description, bio if bio.present? %>

<main class="page">
  <header class="page-header">
    <h1><%= @profile.name %></h1>
    <% if bio.present? %>
      <p class="bio"><%= bio %></p>
    <% end %>
  </header>

  <%= render partial: "group", collection: @groups, locals: { lang: @lang } %>
</main>
