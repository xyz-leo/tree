<header class="site-header">
  <div class="site-header-inner">
    <%= link_to tree.handle, lang_path(tree.lang), class: "brand" %>
    <nav class="site-header-right" aria-label="Idioma / Language">
      <div class="lang-switch">
        <% LinkTree::LANGS.each_with_index do |lang, i| %>
          <% if i > 0 %><span class="lang-sep" aria-hidden="true">|</span><% end %>
          <%= link_to lang.upcase, lang_path(lang),
                class: [ "lang-option", { active: lang == tree.lang } ],
                hreflang: html_lang(lang), lang: html_lang(lang),
                aria: { current: ("page" if lang == tree.lang) } %>
        <% end %>
      </div>
      <%= render "layouts/theme_toggle", label: tree.lang == "en" ? "Toggle light theme" : "Alternar tema claro" %>
    </nav>
  </div>
</header>
