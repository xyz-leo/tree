<header class="site-header">
  <div class="site-header-inner">
    <%= link_to profile.handle, lang_path(lang), class: "brand" %>
    <nav class="site-header-right" aria-label="Idioma / Language">
      <div class="lang-switch">
        <% Translatable::LANGS.each_with_index do |option, i| %>
          <% if i > 0 %><span class="lang-sep" aria-hidden="true">|</span><% end %>
          <%= link_to option.upcase, lang_path(option),
                class: [ "lang-option", { active: option == lang } ],
                hreflang: html_lang(option), lang: html_lang(option),
                aria: { current: ("page" if option == lang) } %>
        <% end %>
      </div>
      <%= render "layouts/theme_toggle", label: lang == "en" ? "Toggle light theme" : "Alternar tema claro" %>
    </nav>
  </div>
</header>
