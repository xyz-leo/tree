# Value of tree/config/master.key
RAILS_MASTER_KEY=

# The single admin user, created on first boot. To change them later, edit
# this file, recreate the container, then run:
#   docker compose -f docker/compose.yml exec tree bin/rails db:seed
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated hostnames the app answers to
APP_HOSTS=links.example.com
